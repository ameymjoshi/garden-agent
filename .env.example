# Copy this file to .env and fill in your values. NEVER commit .env.

# Telegram notifications
# Create a bot with @BotFather, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM parser for inbound messages (default: deterministic 'rules')
# GARDEN_PARSER=llm
# GARDEN_LLM_PROVIDER=ollama          # ollama | sarvam
# GARDEN_LLM_MODEL=qwen2.5:1.5b       # or sarvam-105b
# OLLAMA_HOST=http://localhost:11434
# SARVAM_API_KEY=
