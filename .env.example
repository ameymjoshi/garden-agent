# Copy this file to .env and fill in your values. NEVER commit .env.

# Telegram notifications
# Create a bot with @BotFather, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM parser for inbound messages (default: deterministic 'rules')
# GARDEN_PARSER=llm
# GARDEN_LLM_PROVIDER=gemini          # ollama | sarvam | gemini ('antigravity' = gemini)
# GARDEN_LLM_MODEL=gemini-3.8-flash   # or qwen2.5:1.5b / sarvam-105b
# GEMINI_API_KEY=                     # for provider=gemini/antigravity
# OLLAMA_HOST=http://localhost:11434
# SARVAM_API_KEY=
